{
  "name": "colorful-workspace",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "npm run dev -w @colorful/web",
    "serve": "npm run dev",
    "build": "npm run build -w @colorful-icon/react && npm run build -w @colorful/web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "check": "npm run check -w @colorful-icon/react && npm run check -w @colorful/web",
    "assemble": "npm run assemble -w @colorful-icon/react",
    "redesign": "npm run redesign -w @colorful-icon/react",
    "pack:icons": "npm pack -w @colorful-icon/react",
    "build:icons": "npm run build -w @colorful-icon/react",
    "build:web": "npm run build -w @colorful/web",
    "originals": "npm run originals -w @colorful-icon/react",
    "pack:originals": "npm run pack:originals -w @colorful-icon/react"
  }
}
